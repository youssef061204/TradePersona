PORT=3001
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000
# Optional override. By default resolves repository .venv or PATH Python.
# PYTHON_PATH=/absolute/path/to/python

# Off by default. Requests also need explicit per-session consent.
ENABLE_GEMINI=false
GEMINI_API_KEY=
# Configure a currently available generateContent model explicitly.
GEMINI_MODEL=
ENABLE_AGGREGATE_ANALYTICS=false
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USERNAME=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_ANALYTICS_TABLE=TRADEPERSONA_AGGREGATES
# Optional offline SEC 13F ingestion utility only; never used for user classification.
SEC_USER_AGENT=
